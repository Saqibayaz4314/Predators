NODE_ENV=development
HOST=0.0.0.0
PORT=3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Optional during foundation. Set privately for DB-01; never commit credentials.
DATABASE_URL=
# Optional localhost-only hypothetical fixtures; rejected in production.
# Set HOST=127.0.0.1 when enabling. No database inserts are performed.
SHELTER_DEMO=false
# Optional AI explanation engine (DigitalOcean hosted inference).
# Without the key the backend serves deterministic fallback explanations.
# Never commit the key; store it in GitHub Secrets as DO_GPT_OSS_API_KEY.
DO_GPT_OSS_API_KEY=
DO_GPT_OSS_MODEL=openai-gpt-oss-120b
DO_INFERENCE_URL=https://inference.do-ai.run/v1/chat/completions
AI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=1000
AI_TEMPERATURE=0.2
