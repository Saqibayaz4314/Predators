# Dependencies
node_modules/
/.pnpm-store/

# Environment and secrets
.env
.env.*
!.env.example
k8s/secrets.yaml
**/secrets.yaml

# Local kubeconfig and private keys — never commit
kubeconfig
*.kubeconfig
*.pem
*.key

# Build and test output
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# Logs and local runtime files
*.log
logs/
*.pid
*.pid.lock

# Terraform local state and variable overrides
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
terraform/*.tfvars.json
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json

# Local databases and generated data
*.sqlite
*.sqlite3
*.db
data/

# Raw geospatial datasets — large files, never commit
dataset/*.pbf
dataset/*.osm
dataset/*.osm.gz
dataset/*.zip
dataset/extracted/
dataset/clipped/
dataset/processed/
# Python virtual env for geo preprocessing
scripts/geospatial/.venv/
scripts/geospatial/__pycache__/
scripts/geospatial/*.pyc

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Foundation verification artifacts
.pnpm-store/
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
playwright-report/
test-results/
app/frontend/artifacts/landing/
app/frontend/artifacts/screens/
